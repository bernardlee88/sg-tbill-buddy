'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';

// ── T-Bill Calculator Logic ───────────────────────────────────────────────────
function calcTBill(principal, yieldPct, tenorDays) {
  if (!principal || !yieldPct || !tenorDays) return null;
  const p = parseFloat(principal.toString().replace(/,/g, ''));
  const y = parseFloat(yieldPct) / 100;
  const t = parseInt(tenorDays);
  if (isNaN(p) || isNaN(y) || isNaN(t) || p <= 0) return null;

  // T-Bills are discount instruments — you pay less upfront, get face value at maturity
  const discount = p * y * (t / 365);
  const purchasePrice = p - discount;
  const profit = discount;
  const effectiveYield = (profit / purchasePrice) * (365 / t) * 100;

  return {
    principal: p,
    purchasePrice: purchasePrice,
    maturityValue: p,
    profit: profit,
    effectiveYield: effectiveYield,
    tenorDays: t,
  };
}

function fmt(n) {
  return new Intl.NumberFormat('en-SG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
}

